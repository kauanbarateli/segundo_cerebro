# =============================================================================
# Segundo Cérebro — variáveis de ambiente (EXEMPLO)
# Copie para `.env.local` e preencha. NUNCA faça commit de valores reais.
#
# Legenda de exposição:
#   [browser]  pode chegar ao navegador (prefixo NEXT_PUBLIC_)
#   [server]   somente no servidor — jamais importe em componentes client
#   [migration] usada apenas por migrations/CLI/psql
#   [host]     deve ser cadastrada no painel da hospedagem (ex.: Vercel)
# =============================================================================

# App -------------------------------------------------------------------------
# [browser][host] URL pública base da aplicação.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase --------------------------------------------------------------------
# [browser][host] URL do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# [browser][host] Chave anônima (pública). Protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [server][host] Chave service_role. IGNORA o RLS. NUNCA exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# [migration] Connection string do Postgres. Usada só por migrations/CLI/psql.
SUPABASE_DATABASE_URL=

# Google OAuth / Calendar -----------------------------------------------------
# [server][host] Client ID do OAuth Web Application.
GOOGLE_CLIENT_ID=
# [server][host] Client Secret. NUNCA exponha no navegador.
GOOGLE_CLIENT_SECRET=
# [server][host] Redirect URI. Deve bater EXATAMENTE com o Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/calendar/callback

# Criptografia / jobs ---------------------------------------------------------
# [server][host] Chave AES-256-GCM (32 bytes, Base64) para cifrar refresh tokens
# do Google no servidor. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ou:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# [server][host] ROTAÇÃO DE CHAVE (opcional; substitui a variável acima quando
# preenchida). Lista "id:base64,id:base64" ordenada da chave ATIVA para a mais
# antiga: a primeira cifra o que entra, todas decifram o que já existe.
#
# Como rotacionar SEM reconectar as contas do Google:
#   1. gere a chave nova e ponha na FRENTE, mantendo a antiga atrás:
#        TOKEN_ENCRYPTION_KEYS=v2:<nova>,v1:<antiga>
#      (se hoje você usa TOKEN_ENCRYPTION_KEY, o id da chave antiga é "legado")
#   2. cada conta migra sozinha na próxima reconexão; enquanto isso, as duas
#      chaves funcionam e nada para;
#   3. quando nenhuma linha de google_oauth_credentials citar mais o id antigo
#      (confira a coluna key_id), remova a chave velha da lista.
#
# Remover a chave antiga cedo demais torna as linhas que ainda a citam
# ilegíveis, e a recuperação é reconectar aquelas contas à mão.
TOKEN_ENCRYPTION_KEYS=
# [server][host] Segredo compartilhado que protege a chamada AGENDADA de
# POST /api/google/calendar/sync. Gere com o mesmo comando acima.
#
# Como o agendador manda: `Authorization: Bearer <segredo>` (é o formato que o
# Vercel Cron usa sozinho, lendo esta mesma variável) ou `x-cron-secret:
# <segredo>`. Na URL (?secret=...) NÃO é aceito — URL vai para log e Referer.
#
# VAZIO = ROTA FECHADA, nunca rota aberta: sem segredo configurado, toda
# requisição que apresentar credencial de cron é recusada com 401. A
# sincronização manual pelo usuário logado continua funcionando normalmente.
# Ver src/lib/cron-auth.ts.
CRON_SECRET=

# [server][host] E-MAIL SEMANAL DE MÉTRICAS (segunda, 11h — ver vercel.json).
#
# Chave da API da Resend (https://resend.com). O free tier é de 3.000 e-mails
# por mês; este aplicativo usa 4.
#
# VAZIO = ROTA DESLIGADA, e desligada do jeito certo: sem a chave, a rota
# responde 503 ANTES de reservar a janela na tabela `metric_email_deliveries`.
# Reservar sem enviar queimaria aquela semana para sempre, por causa da UNIQUE
# de idempotência.
#
# ⚠️ ESTA VARIÁVEL SOZINHA NÃO BASTA: `CRON_SECRET` acima também precisa estar
# preenchido, senão o agendador leva 401. Ver src/lib/cron-auth.ts.
RESEND_API_KEY=
# [server][host] Remetente. VAZIO usa `onboarding@resend.dev`, que dispensa
# domínio verificado — em troca, o destinatário TEM que ser o e-mail da conta
# Resend. Para um aplicativo de uma pessoa só, que manda para si mesma, isso
# não é limitação: é o caso.
#
# Com domínio verificado, ponha algo como `Segundo Cérebro <bot@seudominio.com>`
# e nada mais muda no código.
RESEND_FROM=
